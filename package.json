{
	"name": "raatdf",
	"version": "0.2.0",
	"description": "Efficient, elegant and lightweight admin template based on React and Ant Design",
	"author": "any-tdf",
	"license": "MIT",
	"homepage": "https://github.com/any-tdf/raatdf",
	"repository": {
		"type": "git",
		"url": "https://github.com/any-tdf/raatdf"
	},
	"keywords": [
		"react",
		"antd",
		"ant design",
		"tailwind",
		"admin template",
		"后台管理系统",
		"管理后台模板",
		"react 19",
		"tailwind v4",
		"vite"
	],
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"dev:docs": "bun run --cwd doc dev",
		"build": "tsc -b && vp build",
		"preview": "vp preview",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"test": "vp test run --dom",
		"test:watch": "vp test --dom"
	},
	"dependencies": {
		"@ant-design/pro-components": "3.1.14-4",
		"antd": "^6.5.1",
		"axios": "^1.18.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.1",
		"remixicon": "^4.9.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"happy-dom": "^20.11.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
		"vite-plus": "0.2.6"
	},
	"overrides": {
		"picomatch": "4.0.5",
		"postcss": "8.5.22",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	}
}
