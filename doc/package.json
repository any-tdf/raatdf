{
	"name": "doc",
	"private": true,
	"version": "0.2.0",
	"description": "RAATDF documentation site powered by Astro Starlight",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"sync": "astro sync",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"check": "astro check && vp check",
		"check:fix": "vp check --fix && astro check"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.41.4",
		"astro": "^7.1.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"typescript": "~6.0.3",
		"vite-plus": "0.2.6"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	}
}
